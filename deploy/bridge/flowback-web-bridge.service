# see flowback-web-bridge.socket.
[Unit]
Description=Flowback web app bridge to loopback
After=flowback-web.service
Requires=flowback-web-bridge.socket

[Service]
Type=notify
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=256 127.0.0.1:8893
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=32M
CPUQuota=10%
