# installed by deploy/deploy.sh. listens on the server's loopback only: open it through an ssh tunnel.
[Unit]
Description=Flowback audio engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowback
Group=flowback
WorkingDirectory=/opt/flowback/app
Environment=HOME=/var/lib/flowback
Environment=EXACT_COVER_DATA_DIR=/var/lib/flowback/data
Environment=EXACT_COVER_MODEL_DIR=/var/lib/flowback/models
ExecStart=/opt/flowback/app/.venv/bin/python -m cover_engine.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
# separation and transcription take every core they get; other services on the host come first.
Nice=10
CPUWeight=50
MemoryHigh=10G
MemoryMax=12G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flowback
UMask=0077

[Install]
WantedBy=multi-user.target
