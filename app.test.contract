test "the library is the home screen"
  size 900x760
  clock data
  expect tree has "library"
  expect tree has "add-song"
  expect tree missing "add-form"
  expect tree missing "result"

test "adding a song has its own form and returns to the library"
  size 390x844
  clock data
  tap "add-song"
  clock settle
  expect tree has "song-title"
  expect tree has "choose-song"
  expect tree has "choose-vocal"
  expect tree has "create-cover"
  type "song-title" "Dots & Lines"
  tap "add-back"
  clock settle
  expect tree missing "add-form"
  tap "add-song"
  clock settle
  expect state title == "Dots & Lines"
  expect tree missing "result"
