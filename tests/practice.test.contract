test "a song groups takes and supports metric sorting and selection"
  size 900x900
  clock data
  tap "Open Practice fixture"
  clock data
  expect tree has "takes"
  expect text "selected-take-name" == "Take 3 - noisy"
  expect tree has "live-mixer"
  type "take-sort" "timing"
  clock data
  expect state sortBy == "timing"
  expect tree has "ranking-note"
  tap "Select Take 1 - steady"
  clock data
  expect text "selected-take-name" == "Take 1 - steady"
  expect tree has "live-mixer"
  type "take-sort" "range"
  clock data
  expect state sortBy == "range"

test "adding a take unmounts the player and keeps an unfinished named draft"
  size 390x844
  clock data
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  expect tree has "add-take-form"
  expect tree missing "live-mixer"
  expect text "take-song-title" == "Practice fixture"
  expect disabled "create-take"
  type "take-name" "Clearer consonants"
  clock data
  tap "take-back"
  clock settle
  expect tree missing "add-take-form"
  expect tree has "live-mixer"
  tap "add-take"
  clock data
  expect text "take-name" == "Clearer consonants"
  reload
  clock data
  expect state takeDraft.name == "Clearer consonants"

test "new take names belong to their own song"
  size 390x844
  clock data
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  type "take-name" "First song draft"
  clock data
  tap "take-back"
  clock settle
  tap "cover-back"
  clock settle
  tap "Open Other fixture"
  clock data
  tap "add-take"
  clock data
  expect text "take-name" == ""
  type "take-name" "Other song draft"
  clock data
  tap "take-back"
  clock settle
  tap "cover-back"
  clock settle
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  expect text "take-name" == "First song draft"

test "deleting a song asks first and restores all its takes"
  size 390x844
  clock data
  tap "Delete Practice fixture"
  clock settle
  expect tree has "confirm-delete-song"
  tap "cancel-delete-song"
  clock settle
  expect state library.covers.length == 2
  tap "Delete Practice fixture"
  clock settle
  tap "confirm-delete-song"
  clock data
  expect state library.covers.0 .title == "Other fixture"
  expect state library.covers.length == 1
  expect text "library-notice" == "Practice fixture moved to Recently deleted."
  reload
  clock data
  expect state library.covers.length == 1
  tap "recently-deleted"
  clock data
  expect state removedLibrary.covers.0 .title == "Practice fixture"
  expect state removedLibrary.covers.0 .take_count == 3
  tap "Restore Practice fixture"
  clock data
  expect tree has "deleted-empty"
  expect text "restore-notice" == "Practice fixture restored to your songs."
  tap "deleted-back"
  clock data
  tap "Open Practice fixture"
  clock data
  expect state takes.takes.length == 3
  expect text "selected-take-name" == "Take 3 - noisy"
