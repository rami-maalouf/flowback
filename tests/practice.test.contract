test "a song groups takes and supports metric sorting and selection"
  size 900x900
  clock data
  tap "Open Practice fixture"
  clock data
  expect tree has "takes"
  expect text "selected-take-name" == "Take 3 - noisy"
  expect tree has "live-mixer"
  type "take-sort" "timing"
  clock data
  expect state sortBy == "timing"
  expect tree has "ranking-note"
  tap "Select Take 1 - steady"
  clock data
  expect text "selected-take-name" == "Take 1 - steady"
  expect tree has "live-mixer"
  type "take-sort" "range"
  clock data
  expect state sortBy == "range"

test "adding a take pauses the hidden player and keeps an unfinished named draft"
  size 390x844
  clock data
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  expect tree has "add-take-form"
  expect tree missing "live-mixer"
  expect text "take-song-title" == "Practice fixture"
  expect disabled "create-take"
  type "take-name" "Clearer consonants"
  clock data
  tap "take-back"
  clock settle
  expect tree missing "add-take-form"
  expect tree has "live-mixer"
  tap "add-take"
  clock data
  expect text "take-name" == "Clearer consonants"
  reload
  clock data
  expect state takeDraft.name == "Clearer consonants"

test "new take names belong to their own song"
  size 390x844
  clock data
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  type "take-name" "First song draft"
  clock data
  tap "take-back"
  clock settle
  tap "cover-back"
  clock settle
  tap "Open Other fixture"
  clock data
  tap "add-take"
  clock data
  expect text "take-name" == ""
  type "take-name" "Other song draft"
  clock data
  tap "take-back"
  clock settle
  tap "cover-back"
  clock settle
  tap "Open Practice fixture"
  clock data
  tap "add-take"
  clock data
  expect text "take-name" == "First song draft"
