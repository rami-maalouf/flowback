shape Candidate
  id: string
  title: string
  start: number
  end: number
  coverage: number
  score: number
  lyrics: string

shape Job
  id: string
  phase: string
  message: string
  error: string
  candidates: Candidate[]
  selected_id: string
  start: number
  end: number
  duration: number
  warning: string
  vocal_volume: number
  backing_volume: number
  revision: number

shape Draft
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  error: string

shape Session
  title: string
  take_name: string
  studio_origin: string
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  job: Job
  online: bool
  models_available: bool
  error: string

shape SavedCover
  phase: string
  title: string
  id: string
  song_name: string
  vocal_name: string
  saved_at: string
  status: string
  duration: number
  start: number
  end: number
  take_count: number
  latest_take_id: string

shape Take
  id: string
  name: string
  saved_at: string
  phase: string
  status: string
  duration: number
  start: number
  end: number
  comparable: bool
  assessment_status: string
  analysis_status: string
  lyrics: string
  timing: string
  pace: string
  pitch: string
  range: string

shape Takes
  takes: Take[]
  error: string

shape TakeDraft
  name: string
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  error: string

shape Library
  covers: SavedCover[]
  error: string

shape Extraction
  id: string
  song_id: string
  title: string
  song_name: string
  duration: number
  created_at: number
  phase: string
  message: string
  error: string

shape Extractions
  extractions: Extraction[]
  error: string

shape ExtractionDraft
  song_id: string
  song_name: string
  song_duration: number
  error: string

shape ExtractionReply
  ok: bool
  error: string
  id: string

shape Reply
  ok: bool
  error: string

fn pad(n: number): string = n < 10 ? `0${n}` : `${n}`
fn duration(n: number): string = `${floor(n / 60)}:${pad(floor(n) % 60)}`

routes nav
  home "/"
    instrumentals "/instrumentals"
      extract "/instrumentals/extract"
      instrumental "/instrumentals/song"
    deleted "/deleted"
    add "/add"
    cover "/cover"
      addTake "/cover/add-take"

component ExactCover
  resource extractions = loadExtractions() as shape Extractions
  resource extractionDraft = loadExtractionDraft() as shape ExtractionDraft
  resource extraction = loadExtraction(extractionId) as shape Extraction
  mutation extracted as shape ExtractionReply refreshes extractions, extractionDraft then afterExtraction
  mutation extractionChanged as shape Reply refreshes extractionDraft, extraction, extractions then afterExtractionChange
  mutation stemExported as shape Reply then stemPrepared
  state extractionId = "" persist
  state extractionTitle = "" persist
  state extractionQuery = ""
  state extractionIntent = ""
  state extractionSource = "file" persist
  state extractionUrl = "" persist
  state extractionUrlDirty = false persist
  state takeOrigin = "" persist
  state stemKind = ""
  state stemReady = ""
  state stemNotice = ""
  state stemHeight = 300
  derive extractionError = match extracted { case some(r) => r.error, case none => "" }
  derive extractionChangeError = match extractionChanged { case some(r) => r.error, case none => "" }
  derive stemError = match stemExported { case some(r) => r.error, case none => "" }
  derive filteredExtractions = extractions.extractions.filter(e => e.title.toLowerCase().includes(extractionQuery.trim().toLowerCase()) or e.song_name.toLowerCase().includes(extractionQuery.trim().toLowerCase()))
  derive extractionPending = pending(extracted) or pending(extractionChanged) or pending(stemExported)
  action openInstrumentals
    nav = push(nav, "/instrumentals")
    refresh extractions
  action addExtraction
    nav = push(nav, "/instrumentals/extract")
  action editExtractionTitle(value: string)
    extractionTitle = value
  action searchExtractions(value: string)
    extractionQuery = value
  action chooseExtractionSong
    showPicker("extraction-file")
  action extractionPicked(files: Picked[])
    match first(files)
      case some(f)
        extractionIntent = "file"
        send extractionChanged = importExtractionAudio(f.path, f.name, f.size)
      case none
        stemNotice = ""
  action chooseExtractionFileSource
    extractionSource = "file"
    extractionUrlDirty = false
  action chooseExtractionYoutubeSource
    if extractionSource != "youtube"
      extractionUrlDirty = extractionUrl != ""
    extractionSource = "youtube"
  action editExtractionUrl(value: string)
    extractionUrl = value
    extractionUrlDirty = true
  action importExtractionUrl
    extractionIntent = "youtube"
    send extractionChanged = importExtractionYoutube(extractionUrl)
  action afterExtractionChange
    if extractionChangeError == "" and extractionIntent == "youtube"
      extractionUrlDirty = false
    extractionIntent = ""
  action extractSong
    send extracted = createExtraction(extractionTitle)
  action afterExtraction
    match extracted
      case some(r)
        if r.ok
          extractionId = r.id
          extractionTitle = ""
          extractionUrl = ""
          extractionUrlDirty = false
          extractionSource = "file"
          stemReady = ""
          stemNotice = ""
          nav = replace(nav, "/instrumentals/song")
      case none
        stemNotice = ""
  action openExtraction(id: string)
    extractionId = id
    stemReady = ""
    stemNotice = ""
    stemHeight = 300
    nav = push(nav, "/instrumentals/song")
  action retryStem
    extractionIntent = "retry"
    send extractionChanged = retryExtraction(extractionId)
  action extractionCover
    takeOrigin = "extraction"
    intent = "extraction-cover"
    send changed = openExtractionCover(extractionId)
  action exportStem(kind: string)
    if not pending(stemExported)
      stemNotice = ""
      stemKind = kind
      if stemReady == `${extractionId}:${kind}`
        saveFile("stem-file", `app:/tmp/output/${kind}.wav`, `${extraction.title} (${kind == "vocals" ? "Vocals" : "Instrumental"}).wav`)
      else
        stemReady = ""
        send stemExported = prepareStemExport(extractionId, kind)
  action stemPrepared
    if stemError == ""
      stemReady = `${extractionId}:${stemKind}`
  action stemSaved(name: string)
    stemNotice = stemKind == "vocals" ? "Vocals saved." : "Instrumental saved."
  action stemCancelled
    stemNotice = "Save cancelled. Your tracks are still here."
  action stemMessage(data: string)
    if data.startsWith(`flowback-stems:${extractionId}:height:`)
      match parseNumber(data.slice(extractionId.length + 23))
        case some(value)
          if value >= 160 and value <= 1200
            stemHeight = value
        case none
          stemHeight = 300
  resource draft = loadDraft() as shape Draft
  resource session = loadSession() as shape Session
  resource library = loadLibrary() as shape Library
  resource removedLibrary = loadRemovedLibrary() as shape Library
  resource takes = loadTakes(session.song_id, session.job.id, sortBy) as shape Takes
  resource takeDraft = loadTakeDraft(session.song_id) as shape TakeDraft
  mutation changed as shape Reply refreshes session, library, draft, takes, takeDraft then afterChange
  mutation named as shape Reply queue refreshes takeDraft
  mutation exported as shape Reply then exportPrepared
  mutation libraryChanged as shape Reply refreshes library, removedLibrary, session, takes, takeDraft then afterLibraryChange
  state aimedSong = ""
  state aimedTitle = ""
  state aimedTakes = 0
  state libraryIntent = ""
  state libraryFeedback = false
  state libraryNotice = ""
  state source = "file" persist
  state youtubeUrl = "" persist
  state youtubeDirty = false persist
  state title = "" persist
  state query = ""
  state sortBy = "newest"
  state feedback = ""
  state showDetails = false
  state playerHeight = 360
  state intent = ""
  state openingCover = false
  state playerReadyKey = ""
  state exportNote = ""
  state exportReady = false
  state exportKey = ""
  state preparingKey = ""
  state draftKey = ""
  state draftVocal = 100
  state draftBacking = 100
  state originalPosition = -1
  state playbackAt = -1
  derive songs = library.covers.filter(c => c.title.toLowerCase().includes(query.trim().toLowerCase()) or c.vocal_name.toLowerCase().includes(query.trim().toLowerCase()))
  derive visibleError = feedback == "" ? "" : error
  derive mixKey = `${session.job.id}:${session.job.selected_id}:${session.job.revision}`
  derive vocalVolume = draftKey == mixKey ? draftVocal : session.job.vocal_volume
  derive backingVolume = draftKey == mixKey ? draftBacking : session.job.backing_volume
  derive playerKey = `flowback-live:${session.job.id}:${session.job.revision}:`
  derive levelsKey = `${mixKey}:${vocalVolume}:${backingVolume}`
  derive exportPreparedForMix = exportReady and exportKey == levelsKey
  derive busy = session.job.phase == "queued" or session.job.phase == "separating" or session.job.phase == "transcribing" or session.job.phase == "matching" or session.job.phase == "rendering"
  derive error = match changed { case some(r) => r.error, case none => "" }
  derive exportError = match exported { case some(r) => r.error, case none => "" }
  derive canCreate = not youtubeDirty and session.online and session.models_available and draft.song_id != "" and draft.vocal_id != "" and not pending(changed) and not pending(exported)
  derive canCreateTake = session.online and session.models_available and takeDraft.vocal_id != "" and not pending(changed) and not pending(named) and not pending(exported)
  derive nameError = match named { case some(r) => r.error, case none => "" }
  derive libraryActionError = match libraryChanged { case some(r) => r.error, case none => "" }
  derive sortMeaning = sortBy == "lyrics" ? "Higher recognized-word agreement first." : sortBy == "timing" ? "Smaller word-timing differences first." : sortBy == "pace" ? "Pace closest to the original (100%) first." : sortBy == "pitch" ? "Smaller pitch-movement differences first." : "Pitch range closest to the original excerpt first."
  // flowback is dark by default on every host, whatever the system appearance.
  task darkScheme mount
    after(1, useDarkScheme)
  action useDarkScheme
    setScheme("dark")
  task poll mount
    every(2000, refresh)
  action refresh
    if not pending(changed) and not pending(libraryChanged) and not extractionPending
      refresh session
      refresh library
      refresh takes
      refresh extractions
      if top(nav).name == "instrumental"
        refresh extraction
      if top(nav).name == "deleted"
        refresh removedLibrary
  action askDelete(id: string, name: string, count: number)
    if not pending(libraryChanged)
      aimedSong = id
      aimedTitle = name
      aimedTakes = count
      libraryFeedback = false
      libraryNotice = ""
      showModal("delete-song-dialog")
  action deleteSong
    if aimedSong != "" and not pending(libraryChanged)
      libraryIntent = "remove"
      libraryFeedback = false
      send libraryChanged = removeSong(aimedSong)
  action restore(id: string, name: string)
    if not pending(libraryChanged)
      aimedSong = id
      aimedTitle = name
      libraryIntent = "restore"
      libraryFeedback = false
      libraryNotice = ""
      send libraryChanged = restoreSong(id)
  action afterLibraryChange
    libraryFeedback = true
    if libraryActionError == ""
      libraryNotice = libraryIntent == "remove" ? `${aimedTitle} moved to Recently deleted.` : `${aimedTitle} restored to your songs.`
  action retryLibraryChange
    if libraryIntent == "remove"
      deleteSong()
    else
      restore(aimedSong, aimedTitle)
  action openDeleted
    libraryNotice = ""
    libraryFeedback = false
    refresh removedLibrary
    nav = push(nav, "/deleted")
  action back
    if not pending(changed) and not pending(exported) and not pending(named) and not pending(libraryChanged) and not extractionPending
      playerReadyKey = ""
      nav = back(nav)
      refresh library
  action follow(url: string)
    if not pending(changed) and not pending(exported) and not pending(named) and not pending(libraryChanged) and not extractionPending
      playerReadyKey = ""
      nav = go(nav, url)
  action search(value: string)
    query = value
  action clearSearch
    query = ""
  action toggleDetails
    showDetails = not showDetails
  action addSong
    feedback = ""
    intent = ""
    nav = push(nav, "/add")
  action addTake
    takeOrigin = ""
    feedback = ""
    playerReadyKey = ""
    playbackAt = originalPosition
    nav = push(nav, "/cover/add-take")
  action sortTakes(value: string)
    sortBy = value
  action editTakeName(value: string)
    send named = saveTakeName(session.song_id, value)
  action chooseTakeVocal
    showPicker("take-vocal-file")
  action takeVocalPicked(files: Picked[])
    match first(files)
      case some(f)
        intent = "take-vocal"
        send changed = importTakeAudio(session.song_id, f.path, f.name, f.size)
      case none
        feedback = ""
  action makeTake
    intent = "create-take"
    playerReadyKey = ""
    exportNote = ""
    exportReady = false
    draftKey = ""
    playbackAt = -1
    send changed = createTake(session.song_id)
  action chooseFileSource
    source = "file"
    youtubeDirty = false
  action chooseYoutubeSource
    if source != "youtube"
      youtubeDirty = youtubeUrl != ""
    source = "youtube"
  action editYoutube(value: string)
    youtubeUrl = value
    youtubeDirty = true
  action importYoutube
    intent = "youtube"
    openingCover = false
    send changed = importYoutubeAudio(youtubeUrl)
  action editTitle(value: string)
    title = value
  action afterChange
    feedback = intent
    openingCover = false
    if error == "" and (intent == "open" or intent == "create")
      nav = intent == "create" ? replace(nav, "/cover") : push(nav, "/cover")
      if intent == "create"
        title = ""
    if error == "" and intent == "extraction-cover"
      nav = push(nav, "/cover/add-take")
    if error == "" and intent == "create-take"
      nav = takeOrigin == "extraction" ? go(go(nav, "/"), "/cover") : go(nav, "/cover")
      takeOrigin = ""
    if error == "" and intent == "youtube"
      youtubeDirty = false
    if error == "" and intent == "create"
      youtubeUrl = ""
      youtubeDirty = false
      source = "file"
    intent = ""
  action openSaved(id: string)
    showDetails = false
    feedback = ""
    playerHeight = 360
    intent = "open"
    openingCover = true
    playerReadyKey = ""
    draftKey = ""
    exportNote = ""
    exportReady = false
    playbackAt = -1
    originalPosition = -1
    send changed = openCover(id)
  action selectTake(id: string)
    if id != session.job.id
      showDetails = false
      feedback = ""
      playerHeight = 360
      intent = "take"
      openingCover = true
      playbackAt = originalPosition
      playerReadyKey = ""
      draftKey = ""
      exportNote = ""
      exportReady = false
      send changed = openCover(id)
  action chooseSong
    showPicker("song-file")
  action chooseVocal
    showPicker("vocal-file")
  action songPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        intent = "song"
        send changed = importAudio("song", f.path, f.name, f.size)
      case none
        exportNote = ""
  action vocalPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        intent = "vocal"
        send changed = importAudio("vocal", f.path, f.name, f.size)
      case none
        exportNote = ""
  action create
    showDetails = false
    openingCover = false
    exportNote = ""
    exportReady = false
    intent = "create"
    playerReadyKey = ""
    draftKey = ""
    send changed = createCover(title)
  action retry
    intent = "retry"
    send changed = retryCover()
  action choose(id: string)
    intent = "choose"
    openingCover = false
    exportNote = ""
    exportReady = false
    send changed = chooseMatch(id)
  action liveMessage(data: string)
    if data == `${playerKey}ready`
      playerReadyKey = mixKey
    else if data == `${playerKey}loading`
      playerReadyKey = ""
    else if data == `${playerKey}assessment`
      refresh takes
    else if data.startsWith(`${playerKey}position:`)
      match parseNumber(data.slice(playerKey.length + 9))
        case some(value)
          if value >= 0 and value <= session.song_duration
            originalPosition = value
        case none
          originalPosition = -1
    else if data.startsWith(`${playerKey}height:`)
      match parseNumber(data.slice(playerKey.length + 7))
        case some(value)
          if value >= 200
            playerHeight = value
        case none
          playerHeight = 360
    else if data.startsWith(`${playerKey}vocal:`)
      match parseNumber(data.slice(playerKey.length + 6))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = value
            draftBacking = backingVolume
            if value != vocalVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
    else if data.startsWith(`${playerKey}backing:`)
      match parseNumber(data.slice(playerKey.length + 8))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = vocalVolume
            draftBacking = value
            if value != backingVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
  action export
    exportNote = ""
    if playerReadyKey == mixKey and not pending(changed) and not pending(exported) and session.job.phase == "ready"
      if exportPreparedForMix
        saveFile("export-file", "app:/tmp/output/cover.wav", "my-cover.wav")
      else
        preparingKey = levelsKey
        send exported = prepareExport(session.job.id, session.job.revision, vocalVolume, backingVolume)
  action exportPrepared
    exportReady = exportError == ""
    exportKey = preparingKey
  action saved(name: string)
    exportNote = "Cover exported."
  action saveCancelled
    exportNote = "Export cancelled. Your cover is still here."
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="root" width="100%" height="100%" background-color="surface.page" color="text.primary" accent-color="brand.fill"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationBar="none" navigationScroll="library-content" navigationSplit="none" position="absolute" inset=0 display="flex" flex-direction="column"
            header role="toolbar" toolbarPlacement="window" aria-label="Library" display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              text "Flowback" role="heading" aria-level=1 flex=1
              button press=openInstrumentals buttonStyle="bordered" testId="instrumentals"
                text "Instrumentals"
              button press=addSong buttonStyle="bordered-prominent" disabled=(pending(changed) or pending(exported) or pending(libraryChanged)) testId="add-song"
                text "Add song"
            scroll id="library-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="52.5rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="library"
                row gap=14 align-items="center" padding-top=4
                  image "assets/flowback-icon.png" width=64 height=64 flex-shrink=0 aria-hidden=true
                  column gap=6 flex=1 min-width=0
                    text "Your songs" role="heading" aria-level=2 font-size="1.75rem" font-weight=650
                    if library.error != ""
                      text "Library unavailable · Saved on this Mac" font="-exact-subheadline" color="text.secondary"
                    else if pending(library) and library.covers.length == 0
                      text "Opening your library…" font="-exact-subheadline" color="text.secondary"
                    else
                      text `${library.covers.length} ${library.covers.length == 1 ? "song" : "songs"} · Saved on this Mac` font="-exact-subheadline" color="text.secondary"
                if library.error != ""
                  column padding=20 gap=10 border-radius=12 background-color="surface.card" testId="library-error"
                    text "Can’t connect to your library" font-weight=600
                    text library.error role="alert" color="text.secondary" line-height=1.45
                    button press=refresh buttonStyle="bordered" testId="retry-library"
                      text "Try again"
                else if pending(library) and library.covers.length == 0
                  progress aria-label="Loading your songs" testId="library-loading"
                else if library.covers.length == 0
                  column gap=16 padding="48px 24px" align-items="center" testId="library-empty"
                    image "assets/flowback-icon.png" width=100 height=100 aria-hidden=true
                    text "Your first cover starts here" font-size="1.375rem" font-weight=600 text-align="center"
                    text "Bring an original song and your vocal recording. We’ll match the section you sang." color="text.secondary" text-align="center" line-height=1.5 max-width="21.25rem"
                    button press=addSong buttonStyle="bordered-prominent" testId="add-first-song"
                      text "Add your first song"
                else
                  column gap=16
                    input type="search" value=query input=search placeholder="Search your songs" aria-label="Search your songs" testId="song-search" background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                    if songs.length == 0
                      column gap=12 padding="32px 16px" align-items="center" testId="search-empty"
                        text "No matching songs" font-weight=600
                        text "Try another song name or vocal filename." color="text.secondary" text-align="center"
                        button press=clearSearch buttonStyle="bordered" testId="clear-search"
                          text "Clear search"
                    else
                      column border-radius=14 border-width=1 border-style="solid" border-color="border.hairline" overflow="hidden" background-color="surface.card"
                        for cover in songs key=cover.id
                          row align-items="center" flex-wrap="wrap" padding-right=8 border-width=0 border-bottom-width=1 border-style="solid" border-color="border.hairline"
                            button press=openSaved(cover.latest_take_id) disabled=(pending(changed) or pending(exported) or pending(libraryChanged)) aria-label=`Open ${cover.title}` testId=`open-${cover.id}` display="flex" flex-wrap="wrap" align-items="center" gap=14 padding="16px" flex="1 1 12rem" min-width=0 box-sizing="border-box" text-align="left" background-color="transparent" border-width=0 border-radius=0
                              column width="2.625rem" height="2.625rem" flex-shrink=0 align-items="center" justify-content="center" border-radius=10 background-color="surface.soft"
                                image "symbol:waveform" width="1.375rem" height="1.375rem" color="brand.ink"
                              column flex="1 1 8rem" min-width=0 gap=5
                                text cover.title font-weight=600 line-clamp=2
                                row gap=8 flex-wrap="wrap" align-items="center"
                                  text `${cover.take_count} ${cover.take_count == 1 ? "take" : "takes"}` font="-exact-footnote" color="text.secondary"
                                  text cover.status font="-exact-footnote" color=(cover.phase == "failed" ? "-exact-system-red" : "text.secondary")
                                  if cover.duration > 0
                                    text `· ${duration(cover.duration)}` font="-exact-footnote" color="text.secondary" font-variant-numeric="tabular-nums"
                                  text `· ${cover.saved_at}` font="-exact-footnote" color="text.secondary"
                              image "symbol:forward-chevron" width="0.75rem" height="1rem" flex-shrink=0 color="text.secondary"
                            button press=askDelete(cover.id, cover.title, cover.take_count) disabled=(pending(changed) or pending(exported) or pending(libraryChanged)) aria-label=`Delete ${cover.title}` testId=`delete-${cover.id}` background-color="transparent" border-width=0 width="2.75rem" height="2.75rem" flex-shrink=0 display="flex" justify-content="center" align-items="center"
                              image "symbol:delete" width="1.125rem" height="1.25rem" color="text.secondary"
                if pending(libraryChanged)
                  text "Updating library…" role="status" color="text.secondary"
                if libraryNotice != ""
                  text libraryNotice role="status" color="text.secondary" line-height=1.45 testId="library-notice"
                if libraryFeedback and libraryActionError != "" and not pending(libraryChanged)
                  column gap=10
                    text libraryActionError role="alert" color="-exact-system-red" testId="library-change-error"
                    button press=retryLibraryChange buttonStyle="bordered" align-self="start" testId="retry-library-change"
                      text "Try again"
                button press=openDeleted disabled=pending(libraryChanged) buttonStyle="plain" align-self="start" testId="recently-deleted"
                  text "Recently deleted" color="text.secondary"
                if pending(changed) and openingCover
                  text "Opening song…" role="status" color="text.secondary"
                if visibleError != "" and feedback == "open" and not pending(changed)
                  text visibleError color="-exact-system-red" role="alert" testId="library-action-error"
        if entry.name == "instrumentals"
          column navigationKey=`${entry.id}` navigationScroll="instrumentals-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=extractionPending testId="instrumentals-back"
                text "Your songs"
              text "Instrumentals" role="heading" aria-level=2 flex="1 1 auto" min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              button press=addExtraction buttonStyle="bordered-prominent" disabled=extractionPending testId="add-extraction"
                text "Extract song"
            scroll id="instrumentals-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="52.5rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="instrumentals-library"
                column gap=8
                  text "Keep the groove." font-size="1.75rem" font-weight=650 role="heading" aria-level=3
                  text "Separate a song into its instrumental and original vocals. Listen, save either track, or add your voice later." color="text.secondary" line-height=1.5
                if extractions.error != ""
                  column gap=12
                    text extractions.error role="alert" color="-exact-system-red" testId="extractions-error"
                    button press=refresh buttonStyle="bordered"
                      text "Try again"
                else if pending(extractions) and extractions.extractions.length == 0
                  progress aria-label="Loading extracted songs"
                else if extractions.extractions.length == 0
                  column align-items="center" gap=16 padding="40px 20px" testId="extractions-empty"
                    image "symbol:waveform" width="3rem" height="3rem" color="brand.ink" aria-hidden=true
                    text "Just bring the original." font-size="1.375rem" font-weight=600 text-align="center"
                    text "No vocal recording needed. Your extracted tracks will live here." color="text.secondary" text-align="center" line-height=1.5 max-width="21.25rem"
                    button press=addExtraction buttonStyle="bordered-prominent" testId="first-extraction"
                      text "Extract your first song"
                else
                  column gap=16
                    input type="search" value=extractionQuery input=searchExtractions placeholder="Search extracted songs" aria-label="Search extracted songs" testId="extraction-search" background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                    if filteredExtractions.length == 0
                      text "No matching extracted songs." color="text.secondary" testId="extraction-search-empty"
                    for item in filteredExtractions key=item.id
                      button press=openExtraction(item.id) disabled=extractionPending testId=`extraction-${item.id}` aria-label=`Open ${item.title}` display="flex" flex-wrap="wrap" align-items="center" gap=14 padding=18 text-align="left" background-color="surface.card" border-radius=14 border-width=1 border-style="solid" border-color="border.hairline"
                        image "symbol:waveform" width="1.625rem" height="1.625rem" color="brand.ink" flex-shrink=0
                        column flex="1 1 8rem" min-width=0 gap=6
                          text item.title font-weight=600 line-clamp=2
                          text `${duration(item.duration)} · ${item.phase == "ready" ? "Instrumental & vocals" : item.phase == "failed" ? "Needs attention" : "Extracting…"}` font="-exact-footnote" color="text.secondary"
                        image "symbol:forward-chevron" width="0.75rem" height="1rem" color="text.secondary"
        if entry.name == "extract"
          column navigationKey=`${entry.id}` navigationScroll="extract-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=extractionPending testId="extract-back"
                text "Instrumentals"
              text "Extract a song" role="heading" aria-level=2 flex=1
            scroll id="extract-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="40rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="extraction-form"
                column gap=8
                  text "One song. Two tracks." font-size="1.75rem" font-weight=650
                  text "Choose the original recording, including its vocals. We’ll save the full instrumental and vocal tracks separately." color="text.secondary" line-height=1.5
                column gap=8
                  row gap=8 align-items="baseline" flex-wrap="wrap"
                    text "Song name" font-weight=600
                    text "Optional" font="-exact-footnote" color="text.secondary"
                  input value=extractionTitle input=editExtractionTitle maxlength=160 placeholder="Use the imported song’s name" aria-label="Song name" testId="extraction-title" background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="extraction-song-card"
                  row gap=10 align-items="center" flex-wrap="wrap"
                    text "Original song" font-weight=600 flex=1
                    if extractionDraft.song_id != "" and not extractionUrlDirty
                      text "Added" font="-exact-footnote" color="-exact-system-green"
                  row role="tablist" aria-label="Original song source" flex-wrap="wrap" gap=4 padding=4 border-radius=10 background-color="surface.soft"
                    button role="tab" aria-selected=(extractionSource == "file") aria-controls="extraction-source" press=chooseExtractionFileSource disabled=extractionPending testId="extraction-source-file" flex="1 1 8rem" border-width=0 border-radius=7 padding="8px 10px" background-color=(extractionSource == "file" ? "surface.selected" : "transparent") color="text.primary"
                      text "Audio file"
                    button role="tab" aria-selected=(extractionSource == "youtube") aria-controls="extraction-source" press=chooseExtractionYoutubeSource disabled=extractionPending testId="extraction-source-youtube" flex="1 1 8rem" border-width=0 border-radius=7 padding="8px 10px" background-color=(extractionSource == "youtube" ? "surface.selected" : "transparent") color="text.primary"
                      text "YouTube link"
                  column id="extraction-source" role="tabpanel" gap=12
                    if extractionSource == "file"
                      if extractionDraft.song_id == ""
                        text "Choose the full track, including the artist’s vocals." color="text.secondary" font="-exact-subheadline" line-height=1.4
                      button press=chooseExtractionSong buttonStyle="bordered" disabled=extractionPending testId="choose-extraction-song"
                        text (pending(extractionChanged) and extractionIntent == "file" ? "Importing audio…" : extractionDraft.song_id == "" ? "Choose audio file…" : "Replace audio file…")
                      text "WAV, MP3, M4A or FLAC · Up to 64 MB" font="-exact-footnote" color="text.secondary"
                    else
                      row gap=10 flex-wrap="wrap" align-items="center"
                        input value=extractionUrl input=editExtractionUrl placeholder="Paste a YouTube link" aria-label="YouTube link" disabled=extractionPending testId="extraction-youtube-url" flex="1 1 180px" min-width=0 background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                        button press=importExtractionUrl buttonStyle="bordered" disabled=(extractionUrl.trim() == "" or extractionPending) testId="extraction-import-youtube"
                          text (pending(extractionChanged) and extractionIntent == "youtube" ? "Importing…" : "Import")
                      text "Single public video, up to 20 minutes." font="-exact-footnote" color="text.secondary"
                    if pending(extractionChanged)
                      progress aria-label="Importing original song"
                    if extractionDraft.song_id != ""
                      row gap=12 align-items="center"
                        image "symbol:waveform" width="1.25rem" height="1.25rem" color="text.secondary"
                        column flex=1 min-width=0 gap=3
                          text extractionDraft.song_name font-weight=500 line-clamp=2 testId="extraction-song-name"
                          text `${duration(extractionDraft.song_duration)} · ${extractionUrlDirty ? "Import the new link to replace this track" : "Ready to extract"}` font="-exact-footnote" color="text.secondary"
                if extractionDraft.error != ""
                  text extractionDraft.error color="-exact-system-red" role="alert"
                if extractionChangeError != ""
                  text extractionChangeError color="-exact-system-red" role="alert" testId="extraction-import-error"
                if extractionError != ""
                  text extractionError color="-exact-system-red" role="alert" testId="extraction-create-error"
                if not session.online
                  text "The audio engine is disconnected. Reconnecting automatically…" color="text.secondary"
                button press=extractSong buttonStyle="bordered-prominent" disabled=(extractionDraft.song_id == "" or extractionUrlDirty or not session.online or extractionPending) testId="extract-song"
                  text (pending(extracted) ? "Starting…" : "Extract instrumental & vocals")
                text (extractionUrlDirty ? "Import your YouTube link to continue." : "Your draft is saved automatically. You can add your own vocals later.") color="text.secondary" font="-exact-footnote" text-align="center" line-height=1.5
                input type="file" id="extraction-file" testId="extraction-file" display="none" change=extractionPicked
        if entry.name == "instrumental"
          column navigationKey=`${entry.id}` navigationScroll="instrumental-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=(extractionPending or pending(changed)) testId="instrumental-back"
                text "Instrumentals"
              text "Extracted tracks" role="heading" aria-level=2 flex=1
            scroll id="instrumental-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="47.5rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="extraction-detail"
                column gap=8
                  text extraction.title font-size="1.75rem" font-weight=650 line-clamp=3 testId="extracted-title"
                  text `${duration(extraction.duration)} · Full song` color="text.secondary"
                if extraction.phase == "queued" or extraction.phase == "separating"
                  column padding=24 gap=16 border-radius=14 background-color="surface.card" testId="extraction-processing"
                    text "Separating your song" font-size="1.25rem" font-weight=600
                    text extraction.message color="text.secondary" line-height=1.5
                    progress aria-label="Extracting instrumental and vocals"
                    text "You can return to your library. Processing will continue." color="text.secondary" font="-exact-footnote"
                if extraction.error != ""
                  column gap=12 testId="extraction-failure"
                    text extraction.error color="-exact-system-red" role="alert"
                    if extraction.phase == "failed"
                      button press=retryStem buttonStyle="bordered" disabled=(extractionPending or not session.online) testId="retry-extraction"
                        text "Try again"
                    else
                      button press=refresh buttonStyle="bordered"
                        text "Reconnect"
                if extraction.phase == "ready" and top(nav).name == "instrumental"
                  column padding=20 gap=16 border-radius=14 background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline"
                    iframe src=`${session.studio_origin}/studio/stems.html?extraction=${extraction.id}&embedded=1` message=stemMessage aria-label="Instrumental and vocal mixer" width="100%" height=stemHeight border-width=0 hatch="mixer-scroll" testId="stem-player"
                  column gap=12
                    text "Save your tracks" font-weight=600
                    row gap=12 flex-wrap="wrap"
                      button press=exportStem("instrumental") buttonStyle="bordered-prominent" disabled=pending(stemExported) testId="save-instrumental"
                        text (pending(stemExported) and stemKind == "instrumental" ? "Preparing…" : stemReady == `${extractionId}:instrumental` ? "Save instrumental WAV…" : "Download instrumental")
                      button press=exportStem("vocals") buttonStyle="bordered" disabled=pending(stemExported) testId="save-original-vocals"
                        text (pending(stemExported) and stemKind == "vocals" ? "Preparing…" : stemReady == `${extractionId}:vocals` ? "Save vocals WAV…" : "Download vocals")
                    if stemError != ""
                      text stemError color="-exact-system-red" role="alert"
                    if stemNotice != ""
                      text stemNotice role="status" color="text.secondary" testId="stem-save-notice"
                  column gap=12 padding-top=20 border-width=0 border-top-width=1 border-style="solid" border-color="border.hairline"
                    text "Make it yours" font-size="1.25rem" font-weight=600
                    text "Add a vocal recording whenever you’re ready. Your extracted tracks will stay here." color="text.secondary" line-height=1.5
                    button press=extractionCover buttonStyle="bordered" disabled=(pending(changed) or extractionPending) align-self="start" testId="extraction-add-vocals"
                      text "Add your vocals…"
                  text "Separation may leave traces of the original voice or instruments." color="text.secondary" font="-exact-footnote" line-height=1.5
                if extractionChangeError != ""
                  text extractionChangeError color="-exact-system-red" role="alert"
                if visibleError != "" and feedback == "extraction-cover"
                  text visibleError color="-exact-system-red" role="alert"
                input id="stem-file" display="none" change=stemSaved cancel=stemCancelled
        if entry.name == "deleted"
          column navigationKey=`${entry.id}` navigationScroll="deleted-content" navigationSplit="none" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=pending(libraryChanged) testId="deleted-back"
                text "Your songs"
              text "Recently deleted" role="heading" aria-level=2 flex=1
            scroll id="deleted-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="52.5rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="deleted-library"
                text "Deleted songs and their takes stay on this Mac. Restore a song to bring back its recordings, mixes and analyses." color="text.secondary" line-height=1.5
                if removedLibrary.error != ""
                  column gap=12
                    text removedLibrary.error role="alert" color="-exact-system-red"
                    button press=refresh buttonStyle="bordered" testId="retry-deleted"
                      text "Try again"
                else if pending(removedLibrary) and removedLibrary.covers.length == 0
                  progress aria-label="Loading deleted songs"
                else if removedLibrary.covers.length == 0
                  column gap=12 padding="40px 16px" align-items="center" testId="deleted-empty"
                    image "symbol:delete" width="2rem" height="2.25rem" color="text.secondary" aria-hidden=true
                    text "No deleted songs" font-size="1.375rem" font-weight=600
                    text "Songs you delete will appear here." color="text.secondary" text-align="center"
                else
                  column border-radius=14 border-width=1 border-style="solid" border-color="border.hairline" overflow="hidden" background-color="surface.card"
                    for cover in removedLibrary.covers key=cover.id
                      row padding=16 gap=16 align-items="center" border-width=0 border-bottom-width=1 border-style="solid" border-color="border.hairline" testId=`deleted-${cover.id}`
                        column flex=1 min-width=0 gap=6
                          text cover.title font-weight=600 line-clamp=2
                          text `${cover.take_count} ${cover.take_count == 1 ? "take" : "takes"}` font="-exact-footnote" color="text.secondary"
                        button press=restore(cover.id, cover.title) disabled=pending(libraryChanged) buttonStyle="bordered" aria-label=`Restore ${cover.title}` testId=`restore-${cover.id}`
                          text "Restore"
                if pending(libraryChanged)
                  text "Restoring song…" role="status" color="text.secondary"
                if libraryNotice != ""
                  text libraryNotice role="status" color="text.secondary" line-height=1.45 testId="restore-notice"
                if libraryFeedback and libraryActionError != "" and not pending(libraryChanged)
                  column gap=10
                    text libraryActionError role="alert" color="-exact-system-red" testId="restore-error"
                    button press=retryLibraryChange buttonStyle="bordered" align-self="start" testId="retry-restore"
                      text "Try again"
        if entry.name == "add"
          column navigationKey=`${entry.id}` navigationScroll="add-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=pending(changed) testId="add-back"
                text "Your songs"
              text "Add song" role="heading" aria-level=2 flex=1
            scroll id="add-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="40rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="add-form"
                column gap=8
                  text "Choose the original song and your vocal recording." color="text.secondary" line-height=1.45
                column gap=8
                  row gap=8 align-items="baseline" flex-wrap="wrap"
                    text "Song name" font-weight=600
                    text "Optional" font="-exact-footnote" color="text.secondary"
                  input value=title input=editTitle placeholder="Use the imported song’s name" aria-label="Song name" testId="song-title" background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="song-card"
                  row gap=10 align-items="center" flex-wrap="wrap"
                    text "1" font="-exact-footnote" font-weight=600 color="brand.ink"
                    text "Original song" font-weight=600 flex=1
                    if draft.song_id != "" and not youtubeDirty
                      text "Added" font="-exact-footnote" color="-exact-system-green"
                  row role="tablist" aria-label="Original song source" flex-wrap="wrap" gap=4 padding=4 border-radius=10 background-color="surface.soft"
                    button role="tab" aria-selected=(source == "file") aria-controls="original-source" press=chooseFileSource disabled=pending(changed) testId="source-file" flex="1 1 8rem" border-width=0 border-radius=7 padding="8px 10px" background-color=(source == "file" ? "surface.selected" : "transparent") color="text.primary"
                      text "Audio file"
                    button role="tab" aria-selected=(source == "youtube") aria-controls="original-source" press=chooseYoutubeSource disabled=pending(changed) testId="source-youtube" flex="1 1 8rem" border-width=0 border-radius=7 padding="8px 10px" background-color=(source == "youtube" ? "surface.selected" : "transparent") color="text.primary"
                      text "YouTube link"
                  column id="original-source" role="tabpanel" gap=12
                    if source == "file"
                      if draft.song_id == ""
                        text "Choose the full track, including the artist’s vocals." color="text.secondary" font="-exact-subheadline" line-height=1.4 testId="song-name"
                      button press=chooseSong buttonStyle="bordered" disabled=pending(changed) testId="choose-song"
                        text (pending(changed) and intent == "song" ? "Importing audio…" : draft.song_id == "" ? "Choose audio file…" : "Replace audio file…")
                    else
                      row gap=10 flex-wrap="wrap" align-items="center"
                        input value=youtubeUrl input=editYoutube placeholder="Paste a YouTube link" aria-label="YouTube link" disabled=pending(changed) testId="youtube-url" flex="1 1 180px" min-width=0 background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                        button press=importYoutube buttonStyle="bordered" disabled=(youtubeUrl.trim() == "" or pending(changed)) testId="import-youtube"
                          text (pending(changed) and intent == "youtube" ? "Importing…" : "Import")
                      text "Single public video, up to 20 minutes." font="-exact-footnote" color="text.secondary"
                    if pending(changed) and (intent == "song" or intent == "youtube")
                      progress aria-label="Importing original song"
                    if draft.song_id != ""
                      row gap=12 align-items="center"
                        image "symbol:waveform" width="1.25rem" height="1.25rem" color="text.secondary"
                        column flex=1 min-width=0 gap=3
                          text draft.song_name font-weight=500 line-clamp=2 testId="imported-song-name"
                          text `${duration(draft.song_duration)} · ${youtubeDirty ? "Import the new link to replace this track" : "Ready"}` font="-exact-footnote" color="text.secondary"
                    if visibleError != "" and (feedback == "song" or feedback == "youtube") and not pending(changed)
                      text visibleError color="-exact-system-red" role="alert" testId="action-error" line-height=1.4
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="vocal-card"
                  row gap=10 align-items="center" flex-wrap="wrap"
                    text "2" font="-exact-footnote" font-weight=600 color="brand.ink"
                    text "Your vocals" font-weight=600 flex=1
                    if draft.vocal_id != ""
                      text "Added" font="-exact-footnote" color="-exact-system-green"
                  if draft.vocal_id == ""
                    text "A verse, a chorus, or the whole song. Use your voice on its own for the clearest result." color="text.secondary" font="-exact-subheadline" line-height=1.4 testId="vocal-name"
                  else
                    row gap=12 align-items="center"
                      image "symbol:person" width="1.25rem" height="1.25rem" color="text.secondary"
                      column flex=1 min-width=0 gap=3
                        text draft.vocal_name font-weight=500 line-clamp=2 testId="imported-vocal-name"
                        text `${duration(draft.vocal_duration)} · Ready` font="-exact-footnote" color="text.secondary"
                  button press=chooseVocal buttonStyle="bordered" disabled=pending(changed) testId="choose-vocal"
                    text (pending(changed) and intent == "vocal" ? "Importing vocals…" : draft.vocal_id == "" ? "Choose vocal file…" : "Replace vocal file…")
                  if pending(changed) and intent == "vocal"
                    progress aria-label="Importing vocals"
                  if visibleError != "" and feedback == "vocal" and not pending(changed)
                    text visibleError color="-exact-system-red" role="alert" testId="action-error" line-height=1.4
                input type="file" id="song-file" testId="song-file" display="none" change=songPicked
                input type="file" id="vocal-file" testId="vocal-file" display="none" change=vocalPicked
                column gap=12
                  text "WAV, MP3, M4A or FLAC · Up to 64 MB per file" font="-exact-footnote" color="text.secondary"
                  if not session.online
                    text "The audio engine is disconnected. Reconnecting automatically…" color="text.secondary" testId="offline"
                  else if not session.models_available
                    text "Install the audio models to create your first cover." color="text.secondary" testId="models-missing"
                  if visibleError != "" and feedback == "create" and not pending(changed)
                    text visibleError color="-exact-system-red" role="alert" testId="action-error"
                  if draft.error != ""
                    text draft.error color="-exact-system-red" role="alert" testId="session-error"
                  button press=create buttonStyle="bordered-prominent" disabled=(not canCreate) testId="create-cover"
                    text (pending(changed) and intent == "create" ? "Creating…" : "Create cover")
                  text (draft.song_id == "" or draft.vocal_id == "" ? "Add both files to continue. Your draft is saved automatically." : youtubeDirty ? "Import your YouTube link to continue." : "We’ll match and mix only the section you sang.") font="-exact-footnote" color="text.secondary" text-align="center" line-height=1.4
        if entry.name == "addTake"
          column navigationKey=`${entry.id}` navigationScroll="take-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=(pending(changed) or pending(named)) testId="take-back"
                text (takeOrigin == "extraction" ? "Extracted tracks" : "Song")
              text "Add take" role="heading" aria-level=2 flex=1
            scroll id="take-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="40rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="add-take-form"
                column gap=8
                  text session.title font-size="1.5rem" font-weight=650 testId="take-song-title"
                  text (takeOrigin == "extraction" ? "Add your vocal recording. We’ll reuse the extracted instrumental and match the section you sang." : "Add another vocal recording. We’ll reuse the original song and analyze this take separately.") color="text.secondary" line-height=1.45 testId="take-intro"
                column gap=8
                  row gap=8 align-items="baseline" flex-wrap="wrap"
                    text "Take name" font-weight=600
                    text "Optional" font="-exact-footnote" color="text.secondary"
                  input value=takeDraft.name input=editTakeName maxlength=160 placeholder="For example, slower practice" aria-label="Take name" disabled=pending(changed) testId="take-name" background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline" border-radius=10 padding="9px 12px" font-size="1rem"
                  if nameError != ""
                    text nameError role="alert" color="-exact-system-red"
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="take-vocal-card"
                  text "Your vocals" font-weight=600
                  if takeDraft.vocal_id == ""
                    text "A verse, a chorus, or the whole song. Use your voice on its own for the clearest result." color="text.secondary" font="-exact-subheadline" line-height=1.4
                  else
                    column gap=5
                      text takeDraft.vocal_name line-clamp=3 testId="take-vocal-name"
                      text `${duration(takeDraft.vocal_duration)} · Ready` color="text.secondary" font="-exact-footnote"
                  button press=chooseTakeVocal buttonStyle="bordered" disabled=(pending(changed) or pending(named)) testId="choose-take-vocal"
                    text (pending(changed) and intent == "take-vocal" ? "Importing vocals…" : takeDraft.vocal_id == "" ? "Choose vocal file…" : "Replace vocal file…")
                  if pending(changed) and intent == "take-vocal"
                    progress aria-label="Importing take"
                if visibleError != "" and not pending(changed)
                  text visibleError color="-exact-system-red" role="alert" testId="take-error"
                if takeDraft.error != ""
                  text takeDraft.error color="-exact-system-red" role="alert"
                if not session.online
                  text "The audio engine is disconnected. Reconnecting automatically…" color="text.secondary"
                column gap=12
                  text "WAV, MP3, M4A or FLAC · Up to 64 MB" font="-exact-footnote" color="text.secondary"
                  button press=makeTake buttonStyle="bordered-prominent" disabled=(not canCreateTake) testId="create-take"
                    text (pending(changed) and intent == "create-take" ? "Creating…" : "Create take")
                  text "Your draft is saved automatically for this song." font="-exact-footnote" color="text.secondary" text-align="center"
                input type="file" id="take-vocal-file" testId="take-vocal-file" display="none" change=takeVocalPicked
        if entry.name == "cover"
          column navigationKey=`${entry.id}` navigationScroll="cover-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px" background-color="surface.page" border-bottom="1px solid border.hairline"
              button id="back" press=back disabled=(pending(changed) or pending(exported)) testId="cover-back"
                text "Your songs"
              text "Your song" role="heading" aria-level=2 flex=1
              button press=addTake buttonStyle="bordered-prominent" disabled=(session.song_id == "" or pending(changed) or pending(exported)) testId="add-take"
                text "Add take"
            scroll id="cover-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width="47.5rem" margin-left="auto" margin-right="auto" padding=24 gap=24 testId="cover-detail"
                column gap=8 padding-top=8
                  text session.title role="heading" aria-level=3 font-size="1.75rem" font-weight=650 testId="cover-title"
                  if session.job.phase == "ready"
                    text `${duration(session.job.duration)} cover · ${duration(session.job.start)} - ${duration(session.job.end)} in the original` color="text.secondary" font="-exact-subheadline" testId="result-range"
                  else
                    text "Your performance, on the original track." color="text.secondary" font="-exact-subheadline"
                column gap=14 testId="takes"
                  row gap=12 align-items="center" flex-wrap="wrap"
                    text `Your takes (${takes.takes.length})` role="heading" aria-level=3 font-size="1.0625rem" font-weight=600 flex=1 min-width=120
                    select value=sortBy change=sortTakes aria-label="Sort takes" testId="take-sort" max-width="100%"
                      option "Newest first" value="newest"
                      option "Lyric agreement" value="lyrics"
                      option "Timing difference" value="timing"
                      option "Pace match" value="pace"
                      option "Pitch movement difference" value="pitch"
                      option "Pitch range match" value="range"
                  if takes.error != ""
                    text takes.error role="alert" color="-exact-system-red" testId="takes-error"
                  else
                    column border-radius=12 border-width=1 border-style="solid" border-color="border.hairline" overflow="hidden" background-color="surface.card"
                      for take in takes.takes key=take.id
                        button press=selectTake(take.id) aria-pressed=(take.id == session.job.id) aria-label=`Select ${take.name}` disabled=(pending(changed) or pending(exported)) testId=`take-${take.id}` display="flex" flex-direction="column" align-items="stretch" text-align="left" gap=8 padding=14 border-width=0 border-bottom-width=1 border-style="solid" border-color="border.hairline" border-radius=0 background-color=(take.id == session.job.id ? "surface.soft" : "transparent")
                          row gap=10 align-items="center"
                            text take.name font-weight=600 line-clamp=2 flex=1
                            if take.id == session.job.id
                              text "Selected" font="-exact-footnote" color="brand.ink"
                          row gap=8 flex-wrap="wrap"
                            text take.saved_at font="-exact-footnote" color="text.secondary"
                            if take.duration > 0
                              text `· ${duration(take.start)} - ${duration(take.end)}` font="-exact-footnote" color="text.secondary"
                            text `· ${take.phase == "ready" ? take.analysis_status : take.status}` font="-exact-footnote" color="text.secondary"
                          if take.assessment_status == "ready"
                            row gap=10 flex-wrap="wrap"
                              text `Word agreement ${take.lyrics}` font="-exact-caption2" color="text.secondary"
                              text `Timing ${take.timing}` font="-exact-caption2" color="text.secondary"
                              text `Pace ${take.pace}` font="-exact-caption2" color="text.secondary"
                              text `Pitch ${take.pitch}` font="-exact-caption2" color="text.secondary"
                              text `Range ${take.range}` font="-exact-caption2" color="text.secondary"
                          if not take.comparable and take.id != session.job.id
                            text "Different section or method · Not ranked against this take" font="-exact-footnote" color="text.secondary"
                  if sortBy != "newest"
                    text `${sortMeaning} Only comparable sections are ranked; missing measurements appear last.` font="-exact-footnote" color="text.secondary" line-height=1.4 testId="ranking-note"
                  text "Word agreement compares speech-recognized lyrics. It is not an articulation grade." font="-exact-footnote" color="text.secondary" line-height=1.4
                column gap=6
                  text (session.take_name == "" ? session.vocal_name : session.take_name) font-weight=600 testId="selected-take-name"
                  if openingCover
                    text "Opening take…" role="status" color="text.secondary"
                if visibleError != "" and not pending(changed)
                  text visibleError color="-exact-system-red" role="alert"
                if session.error != ""
                  text session.error color="-exact-system-red" role="alert"
                if busy
                  column padding=24 gap=20 border-radius=16 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="processing"
                    column gap=8
                      text "Making your cover" font-size="1.25rem" font-weight=600
                      text session.job.message color="text.secondary" line-height=1.4 testId="progress-message"
                    progress aria-label="Creating cover"
                    column gap=14
                      text "1  Separate the original backing" color=(session.job.phase == "separating" or session.job.phase == "queued" ? "text.primary" : "text.secondary")
                      text "2  Find the lyrics you performed" color=(session.job.phase == "transcribing" or session.job.phase == "matching" ? "text.primary" : "text.secondary")
                      text "3  Align your voice and mix" color=(session.job.phase == "rendering" ? "text.primary" : "text.secondary")
                    text "You can return to your library. Processing will continue." font="-exact-footnote" color="text.secondary"
                if session.job.phase == "failed"
                  column padding=24 gap=14 border-radius=16 background-color="surface.card" testId="failure"
                    text "We couldn’t finish this cover" font-size="1.25rem" font-weight=600
                    text session.job.error role="alert" line-height=1.45 testId="job-error"
                    button press=retry buttonStyle="bordered" disabled=(pending(changed) or not session.online or not session.models_available) testId="retry-cover"
                      text "Try again"
                if session.job.phase == "choose"
                  column gap=16 testId="matches"
                    text "Choose your section" role="heading" aria-level=3 font-size="1.25rem" font-weight=600
                    text "These lyrics repeat in the original. Choose the part you performed." color="text.secondary" line-height=1.45
                    for candidate in session.job.candidates key=candidate.id
                      column padding=20 gap=14 border-radius=14 background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline"
                        text `${duration(candidate.start)} - ${duration(candidate.end)}` font-weight=600 font-variant-numeric="tabular-nums"
                        text candidate.lyrics line-clamp=4 color="text.secondary" line-height=1.5
                        button press=choose(candidate.id) disabled=pending(changed) buttonStyle="bordered" testId=`match-${candidate.id}`
                          text "Use this section"
                if session.job.phase == "ready" and top(nav).name == "cover" and not openingCover
                  column padding=20 gap=16 border-radius=16 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="result"
                    iframe src=`${session.studio_origin}/studio/index.html?job=${session.job.id}&revision=${session.job.revision}&at=${playbackAt}&embedded=1` message=liveMessage aria-label="Live cover mixer" width="100%" height=playerHeight border-width=0 hatch="mixer-scroll" testId="live-mixer"
                    if session.job.error != ""
                      text session.job.error color="-exact-system-red" role="alert" testId="mix-render-error"
                  row align-items="center" gap=12 flex-wrap="wrap"
                    column flex="1 1 180px" min-width=0 gap=5
                      text "Export audio" font-weight=600
                      text "WAV audio with your current mix levels." font="-exact-footnote" color="text.secondary"
                    button press=export buttonStyle="bordered" disabled=(playerReadyKey != mixKey or pending(changed) or pending(exported)) testId="export"
                      text (pending(exported) ? "Preparing…" : exportPreparedForMix ? "Save WAV…" : "Export WAV…")
                  if exportError != ""
                    text exportError color="-exact-system-red" role="alert"
                  if exportNote != ""
                    text exportNote font="-exact-footnote" testId="export-note"
                if session.job.id != ""
                  column gap=14 padding-top=8 border-width=0 border-top-width=1 border-style="solid" border-color="border.hairline"
                    button press=toggleDetails aria-expanded=showDetails testId="cover-details" display="flex" align-items="center" justify-content="space-between" gap=12 text-align="left" padding="10px 0" border-width=0 background-color="transparent" color="text.secondary"
                      text "Recording details"
                      image "symbol:forward-chevron" width="0.75rem" height="0.875rem" rotate=(showDetails ? "90deg" : "0deg")
                    if showDetails
                      column gap=12 testId="recording-details"
                        column gap=4
                          text "Original song" font="-exact-footnote" font-weight=600 color="text.secondary"
                          text session.song_name line-clamp=3
                        column gap=4
                          text "Your vocals" font="-exact-footnote" font-weight=600 color="text.secondary"
                          text session.vocal_name line-clamp=3
                        if session.job.warning != ""
                          text session.job.warning font="-exact-footnote" color="text.secondary" line-height=1.5 testId="result-warning"
                else
                  text "Open a song from your library to listen to your cover." color="text.secondary"
                input id="export-file" display="none" change=saved cancel=saveCancelled
      dialog id="delete-song-dialog" role="alertdialog" aria-label=`Delete ${aimedTitle}?`
        text `Move this song and its ${aimedTakes} ${aimedTakes == 1 ? "take" : "takes"} to Recently deleted? You can restore them anytime.`
        button press=deleteSong destructive=true commandfor="delete-song-dialog" command="close" testId="confirm-delete-song"
          text "Delete song"
        button commandfor="delete-song-dialog" command="close" testId="cancel-delete-song"
          text "Cancel"
