shape Candidate
  id: string
  title: string
  start: number
  end: number
  coverage: number
  score: number
  lyrics: string

shape Job
  id: string
  phase: string
  message: string
  error: string
  candidates: Candidate[]
  selected_id: string
  start: number
  end: number
  duration: number
  warning: string
  vocal_volume: number
  backing_volume: number
  revision: number

shape Draft
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  error: string

shape Session
  title: string
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  job: Job
  online: bool
  models_available: bool
  error: string

shape SavedCover
  phase: string
  title: string
  id: string
  song_name: string
  vocal_name: string
  saved_at: string
  status: string
  duration: number
  start: number
  end: number

shape Library
  covers: SavedCover[]
  error: string

shape Reply
  ok: bool
  error: string

fn pad(n: number): string = n < 10 ? `0${n}` : `${n}`
fn duration(n: number): string = `${floor(n / 60)}:${pad(floor(n) % 60)}`

routes nav
  home "/"
    add "/add"
    cover "/cover"

component ExactCover
  resource draft = loadDraft() as shape Draft
  resource session = loadSession() as shape Session
  resource library = loadLibrary() as shape Library
  mutation changed as shape Reply refreshes session, library, draft then afterChange
  mutation exported as shape Reply then exportPrepared
  state source = "file" persist
  state youtubeUrl = "" persist
  state youtubeDirty = false persist
  state title = "" persist
  state query = ""
  state feedback = ""
  state showDetails = false
  state playerHeight = 360
  state intent = ""
  state openingCover = false
  state playerReadyKey = ""
  state exportNote = ""
  state exportReady = false
  state exportKey = ""
  state preparingKey = ""
  state draftKey = ""
  state draftVocal = 100
  state draftBacking = 100
  derive songs = library.covers.filter(c => c.title.toLowerCase().includes(query.trim().toLowerCase()) or c.vocal_name.toLowerCase().includes(query.trim().toLowerCase()))
  derive visibleError = feedback == "" ? "" : error
  derive mixKey = `${session.job.id}:${session.job.selected_id}:${session.job.revision}`
  derive vocalVolume = draftKey == mixKey ? draftVocal : session.job.vocal_volume
  derive backingVolume = draftKey == mixKey ? draftBacking : session.job.backing_volume
  derive playerKey = `flowback-live:${session.job.id}:${session.job.revision}:`
  derive levelsKey = `${mixKey}:${vocalVolume}:${backingVolume}`
  derive exportPreparedForMix = exportReady and exportKey == levelsKey
  derive busy = session.job.phase == "queued" or session.job.phase == "separating" or session.job.phase == "transcribing" or session.job.phase == "matching" or session.job.phase == "rendering"
  derive error = match changed { case some(r) => r.error, case none => "" }
  derive exportError = match exported { case some(r) => r.error, case none => "" }
  derive canCreate = not youtubeDirty and session.online and session.models_available and draft.song_id != "" and draft.vocal_id != "" and not pending(changed) and not pending(exported)
  task poll mount
    every(2000, refresh)
  action refresh
    if not pending(changed)
      refresh session
      refresh library
  action back
    if not pending(changed) and not pending(exported)
      playerReadyKey = ""
      nav = back(nav)
      refresh library
  action follow(url: string)
    if not pending(changed) and not pending(exported)
      playerReadyKey = ""
      nav = go(nav, url)
  action search(value: string)
    query = value
  action clearSearch
    query = ""
  action toggleDetails
    showDetails = not showDetails
  action addSong
    feedback = ""
    intent = ""
    nav = push(nav, "/add")
  action chooseFileSource
    source = "file"
    youtubeDirty = false
  action chooseYoutubeSource
    if source != "youtube"
      youtubeDirty = youtubeUrl != ""
    source = "youtube"
  action editYoutube(value: string)
    youtubeUrl = value
    youtubeDirty = true
  action importYoutube
    intent = "youtube"
    openingCover = false
    send changed = importYoutubeAudio(youtubeUrl)
  action editTitle(value: string)
    title = value
  action afterChange
    feedback = intent
    if error == "" and (intent == "open" or intent == "create")
      nav = intent == "create" ? replace(nav, "/cover") : push(nav, "/cover")
      if intent == "create"
        title = ""
    if error == "" and intent == "youtube"
      youtubeDirty = false
    if error == "" and intent == "create"
      youtubeUrl = ""
      youtubeDirty = false
      source = "file"
    intent = ""
  action openSaved(id: string)
    showDetails = false
    feedback = ""
    playerHeight = 360
    intent = "open"
    openingCover = true
    playerReadyKey = ""
    draftKey = ""
    exportNote = ""
    exportReady = false
    send changed = openCover(id)
  action chooseSong
    showPicker("song-file")
  action chooseVocal
    showPicker("vocal-file")
  action songPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        intent = "song"
        send changed = importAudio("song", f.path, f.name, f.size)
      case none
        exportNote = ""
  action vocalPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        intent = "vocal"
        send changed = importAudio("vocal", f.path, f.name, f.size)
      case none
        exportNote = ""
  action create
    showDetails = false
    openingCover = false
    exportNote = ""
    exportReady = false
    intent = "create"
    playerReadyKey = ""
    draftKey = ""
    send changed = createCover(title)
  action retry
    intent = "retry"
    send changed = retryCover()
  action choose(id: string)
    intent = "choose"
    openingCover = false
    exportNote = ""
    exportReady = false
    send changed = chooseMatch(id)
  action liveMessage(data: string)
    if data == `${playerKey}ready`
      playerReadyKey = mixKey
    else if data == `${playerKey}loading`
      playerReadyKey = ""
    else if data.startsWith(`${playerKey}height:`)
      match parseNumber(data.slice(playerKey.length + 7))
        case some(value)
          if value >= 200 and value <= 1600
            playerHeight = value
        case none
          playerHeight = 360
    else if data.startsWith(`${playerKey}vocal:`)
      match parseNumber(data.slice(playerKey.length + 6))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = value
            draftBacking = backingVolume
            if value != vocalVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
    else if data.startsWith(`${playerKey}backing:`)
      match parseNumber(data.slice(playerKey.length + 8))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = vocalVolume
            draftBacking = value
            if value != backingVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
  action export
    exportNote = ""
    if playerReadyKey == mixKey and not pending(changed) and not pending(exported) and session.job.phase == "ready"
      if exportPreparedForMix
        saveFile("export-file", "app:/tmp/output/cover.wav", "my-cover.wav")
      else
        preparingKey = levelsKey
        send exported = prepareExport(session.job.id, session.job.revision, vocalVolume, backingVolume)
  action exportPrepared
    exportReady = exportError == ""
    exportKey = preparingKey
  action saved(name: string)
    exportNote = "Cover exported."
  action saveCancelled
    exportNote = "Export cancelled. Your cover is still here."
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="root" width="100%" height="100%" background-color="surface.page" color="text.primary" accent-color="brand.fill"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationScroll="library-content" navigationSplit="none" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px"
              text "Flowback" role="heading" aria-level=1 flex=1
              button press=addSong buttonStyle="bordered-prominent" disabled=(pending(changed) or pending(exported)) testId="add-song"
                text "Add song"
            scroll id="library-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=840 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="library"
                row gap=14 align-items="center" padding-top=4
                  image "assets/flowback-icon.png" width=64 height=64 flex-shrink=0 aria-hidden=true
                  column gap=6 flex=1 min-width=0
                    text "Your songs" role="heading" aria-level=2 font-size=28 font-weight=650
                    text `${library.covers.length} ${library.covers.length == 1 ? "song" : "songs"} · Saved on this Mac` font="-exact-subheadline" color="text.secondary"
                if library.error != ""
                  column padding=20 gap=10 border-radius=12 background-color="surface.card" testId="library-error"
                    text "Can’t connect to your library" font-weight=600
                    text library.error role="alert" color="text.secondary" line-height=1.45
                    button press=refresh buttonStyle="bordered" testId="retry-library"
                      text "Try again"
                else if pending(library) and library.covers.length == 0
                  progress aria-label="Loading your songs" testId="library-loading"
                else if library.covers.length == 0
                  column gap=16 padding="48px 24px" align-items="center" testId="library-empty"
                    image "assets/flowback-icon.png" width=100 height=100 aria-hidden=true
                    text "Your first cover starts here" font-size=22 font-weight=600 text-align="center"
                    text "Bring an original song and your vocal recording. We’ll match the section you sang." color="text.secondary" text-align="center" line-height=1.5 max-width=340
                    button press=addSong buttonStyle="bordered-prominent" testId="add-first-song"
                      text "Add your first song"
                else
                  column gap=16
                    input type="search" value=query input=search placeholder="Search your songs" aria-label="Search your songs" testId="song-search"
                    if songs.length == 0
                      column gap=12 padding="32px 16px" align-items="center" testId="search-empty"
                        text "No matching songs" font-weight=600
                        text "Try another song name or vocal filename." color="text.secondary" text-align="center"
                        button press=clearSearch buttonStyle="bordered" testId="clear-search"
                          text "Clear search"
                    else
                      column border-radius=14 border-width=1 border-style="solid" border-color="border.hairline" overflow="hidden" background-color="surface.card"
                        for cover in songs key=cover.id
                          button press=openSaved(cover.id) disabled=(pending(changed) or pending(exported)) aria-label=`Open ${cover.title}` testId=`open-${cover.id}` display="flex" align-items="center" gap=14 padding="16px" width="100%" box-sizing="border-box" text-align="left" background-color="transparent" border-width=0 border-bottom-width=1 border-style="solid" border-color="border.hairline" border-radius=0
                            column width=42 height=42 flex-shrink=0 align-items="center" justify-content="center" border-radius=10 background-color="surface.soft"
                              image "symbol:waveform" width=22 height=22 color="brand.ink"
                            column flex=1 min-width=0 gap=5
                              text cover.title font-weight=600 line-clamp=2
                              row gap=8 flex-wrap="wrap" align-items="center"
                                text cover.status font="-exact-footnote" color=(cover.phase == "failed" ? "-exact-system-red" : "text.secondary")
                                if cover.duration > 0
                                  text `· ${duration(cover.duration)}` font="-exact-footnote" color="text.secondary" font-variant-numeric="tabular-nums"
                                text `· ${cover.saved_at}` font="-exact-footnote" color="text.secondary"
                            image "symbol:forward-chevron" width=12 height=16 flex-shrink=0 color="text.secondary"
                if pending(changed) and openingCover
                  text "Opening song…" role="status" color="text.secondary"
                if visibleError != "" and feedback == "open" and not pending(changed)
                  text visibleError color="-exact-system-red" role="alert" testId="library-action-error"
        if entry.name == "add"
          column navigationKey=`${entry.id}` navigationScroll="add-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px"
              button id="back" press=back disabled=pending(changed) testId="add-back"
                text "Your songs"
              text "Add song" role="heading" aria-level=2 flex=1
            scroll id="add-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=640 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="add-form"
                column gap=8
                  text "Choose the original song and your vocal recording." color="text.secondary" line-height=1.45
                column gap=8
                  row gap=8 align-items="baseline" flex-wrap="wrap"
                    text "Song name" font-weight=600
                    text "Optional" font="-exact-footnote" color="text.secondary"
                  input value=title input=editTitle placeholder="Use the imported song’s name" aria-label="Song name" testId="song-title"
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="song-card"
                  row gap=10 align-items="center" flex-wrap="wrap"
                    text "1" font="-exact-footnote" font-weight=600 color="brand.ink"
                    text "Original song" font-weight=600 flex=1
                    if draft.song_id != "" and not youtubeDirty
                      text "Added" font="-exact-footnote" color="-exact-system-green"
                  row role="tablist" aria-label="Original song source" gap=4 padding=4 border-radius=10 background-color="surface.soft"
                    button role="tab" aria-selected=(source == "file") aria-controls="original-source" press=chooseFileSource disabled=pending(changed) testId="source-file" flex=1 border-width=0 border-radius=7 padding="8px 10px" background-color=(source == "file" ? "surface.selected" : "transparent") color="text.primary"
                      text "Audio file"
                    button role="tab" aria-selected=(source == "youtube") aria-controls="original-source" press=chooseYoutubeSource disabled=pending(changed) testId="source-youtube" flex=1 border-width=0 border-radius=7 padding="8px 10px" background-color=(source == "youtube" ? "surface.selected" : "transparent") color="text.primary"
                      text "YouTube link"
                  column id="original-source" role="tabpanel" gap=12
                    if source == "file"
                      if draft.song_id == ""
                        text "Choose the full track, including the artist’s vocals." color="text.secondary" font="-exact-subheadline" line-height=1.4 testId="song-name"
                      button press=chooseSong buttonStyle="bordered" disabled=pending(changed) testId="choose-song"
                        text (pending(changed) and intent == "song" ? "Importing audio…" : draft.song_id == "" ? "Choose audio file…" : "Replace audio file…")
                    else
                      row gap=10 flex-wrap="wrap" align-items="center"
                        input value=youtubeUrl input=editYoutube placeholder="Paste a YouTube link" aria-label="YouTube link" disabled=pending(changed) testId="youtube-url" flex="1 1 180px" min-width=0
                        button press=importYoutube buttonStyle="bordered" disabled=(youtubeUrl.trim() == "" or pending(changed)) testId="import-youtube"
                          text (pending(changed) and intent == "youtube" ? "Importing…" : "Import")
                      text "Single public video, up to 20 minutes." font="-exact-footnote" color="text.secondary"
                    if pending(changed) and (intent == "song" or intent == "youtube")
                      progress aria-label="Importing original song"
                    if draft.song_id != ""
                      row gap=12 align-items="center"
                        image "symbol:waveform" width=20 height=20 color="text.secondary"
                        column flex=1 min-width=0 gap=3
                          text draft.song_name font-weight=500 line-clamp=2 testId="imported-song-name"
                          text `${duration(draft.song_duration)} · ${youtubeDirty ? "Import the new link to replace this track" : "Ready"}` font="-exact-footnote" color="text.secondary"
                    if visibleError != "" and (feedback == "song" or feedback == "youtube") and not pending(changed)
                      text visibleError color="-exact-system-red" role="alert" testId="action-error" line-height=1.4
                column padding=20 gap=16 border-radius=14 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="vocal-card"
                  row gap=10 align-items="center" flex-wrap="wrap"
                    text "2" font="-exact-footnote" font-weight=600 color="brand.ink"
                    text "Your vocals" font-weight=600 flex=1
                    if draft.vocal_id != ""
                      text "Added" font="-exact-footnote" color="-exact-system-green"
                  if draft.vocal_id == ""
                    text "A verse, a chorus, or the whole song. Use your voice on its own for the clearest result." color="text.secondary" font="-exact-subheadline" line-height=1.4 testId="vocal-name"
                  else
                    row gap=12 align-items="center"
                      image "symbol:person" width=20 height=20 color="text.secondary"
                      column flex=1 min-width=0 gap=3
                        text draft.vocal_name font-weight=500 line-clamp=2 testId="imported-vocal-name"
                        text `${duration(draft.vocal_duration)} · Ready` font="-exact-footnote" color="text.secondary"
                  button press=chooseVocal buttonStyle="bordered" disabled=pending(changed) testId="choose-vocal"
                    text (pending(changed) and intent == "vocal" ? "Importing vocals…" : draft.vocal_id == "" ? "Choose vocal file…" : "Replace vocal file…")
                  if pending(changed) and intent == "vocal"
                    progress aria-label="Importing vocals"
                  if visibleError != "" and feedback == "vocal" and not pending(changed)
                    text visibleError color="-exact-system-red" role="alert" testId="action-error" line-height=1.4
                input type="file" id="song-file" testId="song-file" display="none" change=songPicked
                input type="file" id="vocal-file" testId="vocal-file" display="none" change=vocalPicked
                column gap=12
                  text "WAV, MP3, M4A or FLAC · Up to 64 MB per file" font="-exact-footnote" color="text.secondary"
                  if not session.online
                    text "The audio engine is disconnected. Reconnecting automatically…" color="text.secondary" testId="offline"
                  else if not session.models_available
                    text "Install the audio models to create your first cover." color="text.secondary" testId="models-missing"
                  if visibleError != "" and feedback == "create" and not pending(changed)
                    text visibleError color="-exact-system-red" role="alert" testId="action-error"
                  if draft.error != ""
                    text draft.error color="-exact-system-red" role="alert" testId="session-error"
                  button press=create buttonStyle="bordered-prominent" disabled=(not canCreate) testId="create-cover"
                    text (pending(changed) and intent == "create" ? "Creating…" : "Create cover")
                  text (draft.song_id == "" or draft.vocal_id == "" ? "Add both files to continue. Your draft is saved automatically." : youtubeDirty ? "Import your YouTube link to continue." : "We’ll match and mix only the section you sang.") font="-exact-footnote" color="text.secondary" text-align="center" line-height=1.4
        if entry.name == "cover"
          column navigationKey=`${entry.id}` navigationScroll="cover-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap" gap=12 padding="10px 20px"
              button id="back" press=back disabled=(pending(changed) or pending(exported)) testId="cover-back"
                text "Your songs"
              text "Your cover" role="heading" aria-level=2 flex=1
            scroll id="cover-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=760 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="cover-detail"
                column gap=8 padding-top=8
                  text session.title role="heading" aria-level=3 font-size=28 font-weight=650 testId="cover-title"
                  if session.job.phase == "ready"
                    text `${duration(session.job.duration)} cover · ${duration(session.job.start)} - ${duration(session.job.end)} in the original` color="text.secondary" font="-exact-subheadline" testId="result-range"
                  else
                    text "Your performance, on the original track." color="text.secondary" font="-exact-subheadline"
                if visibleError != "" and not pending(changed)
                  text visibleError color="-exact-system-red" role="alert"
                if session.error != ""
                  text session.error color="-exact-system-red" role="alert"
                if busy
                  column padding=24 gap=20 border-radius=16 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="processing"
                    column gap=8
                      text "Making your cover" font-size=20 font-weight=600
                      text session.job.message color="text.secondary" line-height=1.4 testId="progress-message"
                    progress aria-label="Creating cover"
                    column gap=14
                      text "1  Separate the original backing" color=(session.job.phase == "separating" or session.job.phase == "queued" ? "text.primary" : "text.secondary")
                      text "2  Find the lyrics you performed" color=(session.job.phase == "transcribing" or session.job.phase == "matching" ? "text.primary" : "text.secondary")
                      text "3  Align your voice and mix" color=(session.job.phase == "rendering" ? "text.primary" : "text.secondary")
                    text "You can return to your library. Processing will continue." font="-exact-footnote" color="text.secondary"
                if session.job.phase == "failed"
                  column padding=24 gap=14 border-radius=16 background-color="surface.card" testId="failure"
                    text "We couldn’t finish this cover" font-size=20 font-weight=600
                    text session.job.error role="alert" line-height=1.45 testId="job-error"
                    button press=retry buttonStyle="bordered" disabled=(pending(changed) or not session.online or not session.models_available) testId="retry-cover"
                      text "Try again"
                if session.job.phase == "choose"
                  column gap=16 testId="matches"
                    text "Choose your section" role="heading" aria-level=3 font-size=20 font-weight=600
                    text "These lyrics repeat in the original. Choose the part you performed." color="text.secondary" line-height=1.45
                    for candidate in session.job.candidates key=candidate.id
                      column padding=20 gap=14 border-radius=14 background-color="surface.card" border-width=1 border-style="solid" border-color="border.hairline"
                        text `${duration(candidate.start)} - ${duration(candidate.end)}` font-weight=600 font-variant-numeric="tabular-nums"
                        text candidate.lyrics line-clamp=4 color="text.secondary" line-height=1.5
                        button press=choose(candidate.id) disabled=pending(changed) buttonStyle="bordered" testId=`match-${candidate.id}`
                          text "Use this section"
                if session.job.phase == "ready"
                  column padding=20 gap=16 border-radius=16 background-color="surface.card" border-style="solid" border-width=1 border-color="border.hairline" testId="result"
                    iframe src=`http://127.0.0.1:8891/studio/index.html?job=${session.job.id}&revision=${session.job.revision}` message=liveMessage aria-label="Live cover mixer" width="100%" height=playerHeight border-width=0 testId="live-mixer"
                    if session.job.error != ""
                      text session.job.error color="-exact-system-red" role="alert" testId="mix-render-error"
                  row align-items="center" gap=12 flex-wrap="wrap"
                    column flex="1 1 180px" min-width=0 gap=5
                      text "Export audio" font-weight=600
                      text "WAV audio with your current mix levels." font="-exact-footnote" color="text.secondary"
                    button press=export buttonStyle="bordered" disabled=(playerReadyKey != mixKey or pending(changed) or pending(exported)) testId="export"
                      text (pending(exported) ? "Preparing…" : exportPreparedForMix ? "Save WAV…" : "Export WAV…")
                  if exportError != ""
                    text exportError color="-exact-system-red" role="alert"
                  if exportNote != ""
                    text exportNote font="-exact-footnote" testId="export-note"
                if session.job.id != ""
                  column gap=14 padding-top=8 border-width=0 border-top-width=1 border-style="solid" border-color="border.hairline"
                    button press=toggleDetails aria-expanded=showDetails testId="cover-details" display="flex" align-items="center" justify-content="space-between" gap=12 text-align="left" padding="10px 0" border-width=0 background-color="transparent" color="text.secondary"
                      text "Recording details"
                      image "symbol:forward-chevron" width=12 height=14 rotate=(showDetails ? "90deg" : "0deg")
                    if showDetails
                      column gap=12 testId="recording-details"
                        column gap=4
                          text "Original song" font="-exact-footnote" font-weight=600 color="text.secondary"
                          text session.song_name line-clamp=3
                        column gap=4
                          text "Your vocals" font="-exact-footnote" font-weight=600 color="text.secondary"
                          text session.vocal_name line-clamp=3
                        if session.job.warning != ""
                          text session.job.warning font="-exact-footnote" color="text.secondary" line-height=1.5 testId="result-warning"
                else
                  text "Open a song from your library to listen to your cover." color="text.secondary"
                input id="export-file" display="none" change=saved cancel=saveCancelled
