shape Candidate
  id: string
  title: string
  start: number
  end: number
  coverage: number
  score: number
  lyrics: string

shape Job
  id: string
  phase: string
  message: string
  error: string
  candidates: Candidate[]
  selected_id: string
  start: number
  end: number
  duration: number
  warning: string
  vocal_volume: number
  backing_volume: number
  revision: number

shape Draft
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  error: string

shape Session
  title: string
  song_id: string
  song_name: string
  song_duration: number
  vocal_id: string
  vocal_name: string
  vocal_duration: number
  job: Job
  online: bool
  models_available: bool
  error: string

shape SavedCover
  title: string
  id: string
  song_name: string
  vocal_name: string
  saved_at: string
  status: string
  duration: number
  start: number
  end: number

shape Library
  covers: SavedCover[]
  error: string

shape Reply
  ok: bool
  error: string

fn pad(n: number): string = n < 10 ? `0${n}` : `${n}`
fn duration(n: number): string = `${floor(n / 60)}:${pad(floor(n) % 60)}`

routes nav
  home "/"
    add "/add"
    cover "/cover"

component ExactCover
  resource draft = loadDraft() as shape Draft
  resource session = loadSession() as shape Session
  resource library = loadLibrary() as shape Library
  mutation changed as shape Reply refreshes session, library, draft then afterChange
  mutation exported as shape Reply then exportPrepared
  state title = ""
  state intent = ""
  state openingCover = false
  state playerReadyKey = ""
  state exportNote = ""
  state exportReady = false
  state exportKey = ""
  state preparingKey = ""
  state draftKey = ""
  state draftVocal = 100
  state draftBacking = 100
  derive mixKey = `${session.job.id}:${session.job.selected_id}:${session.job.revision}`
  derive vocalVolume = draftKey == mixKey ? draftVocal : session.job.vocal_volume
  derive backingVolume = draftKey == mixKey ? draftBacking : session.job.backing_volume
  derive playerKey = `flowback-live:${session.job.id}:${session.job.revision}:`
  derive levelsKey = `${mixKey}:${vocalVolume}:${backingVolume}`
  derive exportPreparedForMix = exportReady and exportKey == levelsKey
  derive busy = session.job.phase == "queued" or session.job.phase == "separating" or session.job.phase == "transcribing" or session.job.phase == "matching" or session.job.phase == "rendering"
  derive error = match changed { case some(r) => r.error, case none => "" }
  derive exportError = match exported { case some(r) => r.error, case none => "" }
  derive canCreate = session.online and session.models_available and draft.song_id != "" and draft.vocal_id != "" and not pending(changed) and not pending(exported)
  task poll mount
    every(2000, refresh)
  action refresh
    if not pending(changed)
      refresh session
      refresh library
  action back
    if not pending(changed) and not pending(exported)
      playerReadyKey = ""
      nav = back(nav)
      refresh library
  action follow(url: string)
    if not pending(changed) and not pending(exported)
      playerReadyKey = ""
      nav = go(nav, url)
  action addSong
    intent = ""
    nav = push(nav, "/add")
  action editTitle(value: string)
    title = value
  action afterChange
    if error == "" and (intent == "open" or intent == "create")
      nav = intent == "create" ? replace(nav, "/cover") : push(nav, "/cover")
      if intent == "create"
        title = ""
    intent = ""
  action openSaved(id: string)
    intent = "open"
    openingCover = true
    playerReadyKey = ""
    draftKey = ""
    exportNote = ""
    exportReady = false
    send changed = openCover(id)
  action chooseSong
    showPicker("song-file")
  action chooseVocal
    showPicker("vocal-file")
  action songPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        send changed = importAudio("song", f.path, f.name, f.size)
      case none
        exportNote = ""
  action vocalPicked(files: Picked[])
    match first(files)
      case some(f)
        openingCover = false
        exportReady = false
        send changed = importAudio("vocal", f.path, f.name, f.size)
      case none
        exportNote = ""
  action create
    openingCover = false
    exportNote = ""
    exportReady = false
    intent = "create"
    playerReadyKey = ""
    draftKey = ""
    send changed = createCover(title)
  action choose(id: string)
    openingCover = false
    exportNote = ""
    exportReady = false
    send changed = chooseMatch(id)
  action liveMessage(data: string)
    if data == `${playerKey}ready`
      playerReadyKey = mixKey
    else if data == `${playerKey}loading`
      playerReadyKey = ""
    else if data.startsWith(`${playerKey}vocal:`)
      match parseNumber(data.slice(playerKey.length + 6))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = value
            draftBacking = backingVolume
            if value != vocalVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
    else if data.startsWith(`${playerKey}backing:`)
      match parseNumber(data.slice(playerKey.length + 8))
        case some(value)
          if value >= 0 and value <= 200
            draftKey = mixKey
            draftVocal = vocalVolume
            draftBacking = value
            if value != backingVolume
              exportReady = false
              exportNote = ""
        case none
          exportReady = false
  action export
    exportNote = ""
    if playerReadyKey == mixKey and not pending(changed) and not pending(exported) and session.job.phase == "ready"
      if exportPreparedForMix
        saveFile("export-file", "app:/tmp/output/cover.wav", "my-cover.wav")
      else
        preparingKey = levelsKey
        send exported = prepareExport(session.job.id, session.job.revision, vocalVolume, backingVolume)
  action exportPrepared
    exportReady = exportError == ""
    exportKey = preparingKey
  action saved(name: string)
    exportNote = "Cover exported."
  action saveCancelled
    exportNote = "Export cancelled. Your cover is still here."
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="root" width="100%" height="100%" background-color="-exact-background"
      for entry in stack(nav) key=entry.id
        if entry.name == "home"
          column navigationKey=`${entry.id}` navigationScroll="library-content" navigationSplit="none" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap"
              text "Flowback" role="heading" aria-level=1 flex=1
              button press=addSong buttonStyle="filled" disabled=(pending(changed) or pending(exported)) testId="add-song"
                text "Add song"
            scroll id="library-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=720 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="library"
                column gap=8 padding-top=12
                  text "Your songs" role="heading" aria-level=2 font-size=30 font-weight=650
                  text "Your performances, ready when you are. Open a song to listen and adjust your mix." color="-exact-secondary-label" line-height=1.5
                if library.error != ""
                  text library.error role="alert" color="-exact-system-red" testId="library-error"
                else if library.covers.length == 0
                  column gap=12 padding=28 border-radius=16 background-color="-exact-secondary-background" testId="library-empty"
                    image "symbol:waveform" width=36 height=36 color="-exact-secondary-label"
                    text "Make room for your first song" font-size=20 font-weight=600
                    text "Add the original song and your vocal file. We’ll find your section and keep your cover here." color="-exact-secondary-label" line-height=1.5
                else
                  column gap=12
                    for cover in library.covers key=cover.id
                      column gap=10 padding=18 border-radius=14 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId=`saved-${cover.id}`
                        row gap=14 align-items="center"
                          image "symbol:waveform" width=28 height=28 color="-exact-secondary-label"
                          column flex=1 min-width=0 gap=5
                            text cover.title font-weight=600 line-clamp=2
                            text `${cover.status}${cover.duration > 0 ? ` · ${duration(cover.duration)}` : ""}` font="-exact-footnote" color="-exact-secondary-label"
                        text cover.vocal_name color="-exact-secondary-label" line-clamp=1 font="-exact-footnote"
                        row gap=12 align-items="center" flex-wrap="wrap"
                          text cover.saved_at flex=1 font="-exact-footnote" color="-exact-secondary-label"
                          button press=openSaved(cover.id) buttonStyle="bordered" disabled=(pending(changed) or pending(exported)) testId=`open-${cover.id}`
                            text "Open song"
                if pending(changed) and openingCover
                  text "Opening song…" color="-exact-secondary-label"
                if error != "" and not pending(changed)
                  text error color="-exact-system-red" role="alert" testId="library-action-error"
                text "Songs and mix levels are saved on this Mac." font="-exact-footnote" color="-exact-secondary-label"
        if entry.name == "add"
          column navigationKey=`${entry.id}` navigationScroll="add-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap"
              button id="back" press=back disabled=pending(changed) testId="add-back"
                text "Your songs"
              text "Add song" role="heading" aria-level=2 flex=1
            scroll id="add-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=720 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="add-form"
                column gap=8
                  text "Bring the song. Add your voice." role="heading" aria-level=3 font-size=24 font-weight=600
                  text "Use the original lyrics. A verse, a chorus, or the whole song is enough." color="-exact-secondary-label" line-height=1.5
                column gap=8
                  text "Song name" font-weight=600
                  input value=title input=editTitle placeholder="Use the original song’s name" aria-label="Song name" testId="song-title"
                  text "Leave blank to use the imported song’s name." font="-exact-footnote" color="-exact-secondary-label"
                row gap=16 flex-wrap="wrap" align-items="stretch"
                  column flex="1 1 260px" min-width=0 padding=20 gap=14 border-radius=16 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId="song-card"
                    row gap=10 align-items="center"
                      image "symbol:waveform" width=22 height=22 color="-exact-secondary-label"
                      text "Original song" font-weight=600
                    column gap=5 flex=1
                      text (draft.song_name == "" ? "Start with the full song" : draft.song_name) font-weight=500 line-clamp=2 testId="song-name"
                      text (draft.song_name == "" ? "Include the artist’s vocals so we can find your section." : `${duration(draft.song_duration)} · ready to match`) font="-exact-footnote" color="-exact-secondary-label" line-height=1.4
                    button press=chooseSong buttonStyle="bordered" disabled=pending(changed) testId="choose-song"
                      text (draft.song_name == "" ? "Choose song…" : "Change song…")
                  column flex="1 1 260px" min-width=0 padding=20 gap=14 border-radius=16 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId="vocal-card"
                    row gap=10 align-items="center"
                      image "symbol:person" width=22 height=22 color="-exact-secondary-label"
                      text "Your vocals" font-weight=600
                    column gap=5 flex=1
                      text (draft.vocal_name == "" ? "A verse, a chorus, or all of it" : draft.vocal_name) font-weight=500 line-clamp=2 testId="vocal-name"
                      text (draft.vocal_name == "" ? "The same lyrics, performed by you. A clean vocal works best." : `${duration(draft.vocal_duration)} · ready to align`) font="-exact-footnote" color="-exact-secondary-label" line-height=1.4
                    button press=chooseVocal buttonStyle="bordered" disabled=pending(changed) testId="choose-vocal"
                      text (draft.vocal_name == "" ? "Choose vocals…" : "Change vocals…")
                input type="file" id="song-file" testId="song-file" display="none" change=songPicked
                input type="file" id="vocal-file" testId="vocal-file" display="none" change=vocalPicked
                column gap=10
                  row gap=12 flex-wrap="wrap" align-items="center"
                    button press=create buttonStyle="filled" disabled=(not canCreate) testId="create-cover"
                      text (pending(changed) and intent == "create" ? "Adding song…" : "Add song & create cover")
                    text (pending(changed) ? "Preparing your files…" : "Only the section you sang will be exported.") font="-exact-footnote" color="-exact-secondary-label"
                  if not session.online
                    text "The local audio engine is unavailable. Start it, then this screen will reconnect automatically." color="-exact-secondary-label" testId="offline"
                  else if not session.models_available
                    text "The audio engine needs its model dependencies installed before it can process a cover." color="-exact-secondary-label" testId="models-missing"
                  if error != "" and not pending(changed)
                    text error color="-exact-system-red" role="alert" testId="action-error"
                  if draft.error != ""
                    text draft.error color="-exact-system-red" role="alert" testId="session-error"
        if entry.name == "cover"
          column navigationKey=`${entry.id}` navigationScroll="cover-content" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" flex-wrap="wrap"
              button press=back disabled=(pending(changed) or pending(exported)) testId="cover-back"
                text "Your songs"
              text "Your cover" role="heading" aria-level=2 flex=1
            scroll id="cover-content" flex=1 min-height=0
              column width="100%" box-sizing="border-box" min-width=0 max-width=720 margin-left="auto" margin-right="auto" padding=24 gap=24 testId="cover-detail"
                column gap=8
                  text session.title role="heading" aria-level=3 font-size=28 font-weight=650 testId="cover-title"
                  text session.vocal_name color="-exact-secondary-label" line-clamp=2
                if error != "" and not pending(changed)
                  text error color="-exact-system-red" role="alert"
                if session.error != ""
                  text session.error color="-exact-system-red" role="alert"
                if busy
                  column padding=20 gap=10 border-radius=16 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId="processing"
                    progress aria-label="Creating cover"
                    text session.job.message font-weight=600 testId="progress-message"
                    text "Your files stay on this Mac. The first run may download model files." font="-exact-footnote" color="-exact-secondary-label"
                if session.job.phase == "failed"
                  column padding=20 gap=8 border-radius=16 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId="failure"
                    text "This cover needs another try" font-weight=600
                    text session.job.error role="alert" testId="job-error"
                if session.job.phase == "choose"
                  column gap=14 testId="matches"
                    text "Which section did you sing?" role="heading" aria-level=3 font-size=20 font-weight=600
                    text "These lyrics appear in more than one place, or the match needs your confirmation." color="-exact-secondary-label"
                    for candidate in session.job.candidates key=candidate.id
                      column padding=16 gap=10 border-radius=12 background-color="-exact-secondary-background"
                        text `${duration(candidate.start)} - ${duration(candidate.end)}` font-weight=600
                        text candidate.lyrics line-clamp=3 color="-exact-secondary-label"
                        button press=choose(candidate.id) disabled=pending(changed) buttonStyle="bordered" testId=`match-${candidate.id}`
                          text "Use this section"
                if session.job.phase == "ready"
                  column padding=20 gap=16 border-radius=16 background-color="-exact-secondary-background" border-style="solid" border-width=1 border-color="-exact-separator" testId="result"
                    row gap=10 align-items="center" flex-wrap="wrap"
                      text "Your cover is ready" role="heading" aria-level=3 font-size=22 font-weight=600 flex=1
                      text duration(session.job.duration) font-variant-numeric="tabular-nums" color="-exact-secondary-label"
                    text `From ${duration(session.job.start)} to ${duration(session.job.end)} in the original song.` color="-exact-secondary-label" testId="result-range"
                    if session.job.error != ""
                      text session.job.error color="-exact-system-red" role="alert" testId="mix-render-error"
                    iframe src=`http://127.0.0.1:8891/studio/index.html?job=${session.job.id}&revision=${session.job.revision}` message=liveMessage aria-label="Live cover mixer" width="100%" height=280 border-width=0 testId="live-mixer"
                    if session.job.warning != ""
                      text session.job.warning font="-exact-footnote" color="-exact-secondary-label" testId="result-warning"
                    button press=export buttonStyle="filled" disabled=(playerReadyKey != mixKey or pending(changed) or pending(exported)) testId="export"
                      text (pending(exported) ? "Preparing export…" : exportPreparedForMix ? "Save WAV…" : "Prepare WAV")
                    if exportError != ""
                      text exportError color="-exact-system-red" role="alert"
                    if exportNote != ""
                      text exportNote font="-exact-footnote" testId="export-note"
                if session.job.id == ""
                  text "Open a song from your library to listen to your cover." color="-exact-secondary-label"
                input id="export-file" display="none" change=saved cancel=saveCancelled
